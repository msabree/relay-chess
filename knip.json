{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/web": {
      "entry": ["jest.config.js"],
      "ignore": ["public/**", "src/components/ui/**"],
      "jest": {
        "config": [],
        "entry": ["__tests__/**/*.test.{ts,tsx}"]
      },
      "ignoreDependencies": ["jest-environment-jsdom"]
    },
    "apps/mobile": {
      "entry": ["components/**/*.ios.tsx"],
      "ignoreBinaries": ["eas"],
      "ignoreDependencies": ["expo-updates"]
    }
  }
}
