# Copy to .env and fill in.
PORT=4000

# Shared with apps/web. Signs session tokens. Generate with `openssl rand -base64 32`.
AUTH_SECRET=dev-only-change-me

# Leave empty to keep everything in memory (fine for local dev, data is lost on restart).
# With docker compose: mongodb://localhost:27017
MONGODB_URL=
DATABASE_NAME=relaychess

# Comma-separated browser origins allowed to call the server.
CORS_ORIGINS=http://localhost:3000

# Let people play without signing in.
GUEST_LOGIN=true
