# Copy to .env and fill in.
PORT=4000

# Signs player tokens. Generate with `openssl rand -base64 48`.
AUTH_SECRET=dev-only-change-me

# Leave empty to keep everything in memory (fine for local dev, data is lost on restart).
# With docker compose: mongodb://localhost:27017
MONGODB_URL=
DATABASE_NAME=relaychess
# Optional: games played before this database, added to the count on the homepage.
LEGACY_GAMES_PLAYED=0

# Optional accounts: sign in with a code sent by email.
# This server's public URL, and the web app (sign-in emails link there).
SERVER_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Leave empty and codes are printed in this server's log instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Relay Chess <play@relaychess.com>

# Comma-separated browser origins allowed to call the server.
CORS_ORIGINS=http://localhost:3000
