# Copy to .env.local and fill in.

# apps/server (HTTP API + sockets on one port)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Must match AUTH_SECRET in apps/server/.env. Used to vouch for signed-in users.
AUTH_SECRET=dev-only-change-me

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers (optional; without them everyone plays as a guest)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional: Google Analytics 4 measurement id. Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Show the Sign in button (needs the Google/Apple keys above)
NEXT_PUBLIC_ENABLE_SIGN_IN=false
