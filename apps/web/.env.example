# Copy to .env.local and fill in.

# Where the Relay Chess server runs (see apps/server)
NEXT_PUBLIC_CHESS_SERVER_API=http://localhost:3001
NEXT_PUBLIC_CHESS_SERVER_SOCKETS=http://localhost:4000
CHESS_SERVER_API=http://localhost:3001

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers (server-side only, never NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional: Google Analytics 4 measurement id. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
